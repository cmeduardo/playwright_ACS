{
  "name": "tiendaqa-playwright",
  "version": "1.0.0",
  "description": "Proyecto académico de Playwright con la aplicación TiendaQA (UMG - Aseguramiento de la Calidad del Software)",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "app": "node app/server.js",
    "db:reset": "node scripts/db-reset.js",
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:api": "playwright test --project=api",
    "test:visual": "playwright test --grep @visual",
    "test:visual:update": "cross-env BUGS=off playwright test --grep @visual --project=chromium --update-snapshots",
    "test:a11y": "playwright test --grep @a11y",
    "test:mobile": "playwright test --grep @mobile",
    "test:headed": "playwright test --headed --project=chromium",
    "test:ui": "playwright test --ui",
    "codegen": "playwright codegen http://localhost:3100",
    "lint": "eslint tests playwright.config.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write tests playwright.config.ts",
    "reportes:limpiar": "node scripts/limpiar-reportes.js",
    "dashboard": "tsx scripts/dashboard.ts",
    "report": "playwright show-report playwright-report",
    "report:allure": "allure generate allure-results -o allure-report && allure open allure-report",
    "report:allure:generar": "allure generate allure-results -o allure-report",
    "docs:casos": "tsx scripts/generar-docs.ts",
    "bitacora": "node scripts/consultar-bitacora.js",
    "docs:verificar": "node scripts/verificar-docs.js",
    "test:bugs": "cross-env BUGS=on playwright test",
    "test:fixed": "cross-env BUGS=off playwright test",
    "ciclo:completo": "node scripts/ciclo-completo.js",
    "reportes:abrir": "node scripts/reportes-abrir.js",
    "reportes:detener": "node scripts/reportes-detener.js",
    "app:fixed": "cross-env BUGS=off node app/server.js",
    "capturas": "node scripts/capturas.js",
    "traza": "node scripts/abrir-traza.js",
    "navegador": "cross-env RECORRIDOS=1 BUGS=on playwright test --project=recorridos",
    "navegador:grabar": "cross-env RECORRIDOS=1 RECORRIDOS_GRABAR=1 BUGS=on playwright test --project=recorridos",
    "navegador:corregido": "cross-env RECORRIDOS=1 BUGS=off playwright test --project=recorridos",
    "navegador:fallas": "cross-env RECORRIDOS=1 BUGS=on playwright test --project=recorridos --grep @recorrido-defecto",
    "navegador:aciertos": "cross-env RECORRIDOS=1 BUGS=on playwright test --project=recorridos --grep @recorrido-ok"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "allure": "^3.20.0",
    "allure-js-commons": "^3.13.0",
    "allure-playwright": "^3.13.0",
    "chart.js": "^4.5.1",
    "cross-env": "^10.1.0",
    "csv-parse": "^7.0.3",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
